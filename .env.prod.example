# ==============================================================================
# Seed Platform - Configurações de Produção (.env.prod)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para .env.prod no servidor de produção:
#    cp .env.prod.example .env.prod
# 2. Gere chaves criptográficas seguras:
#    openssl rand -hex 32
# ==============================================================================

# Banco de Dados PostgreSQL / PostGIS
POSTGRES_DB=seed_prod
POSTGRES_USER=seed_admin
POSTGRES_PASSWORD=gere_uma_senha_forte_aqui_ex_openssl_rand_hex_24

# Chave de Criptografia JWT
# GERE COM: openssl rand -hex 32
SECRET_KEY=substitua_por_uma_chave_criptografica_real_em_producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# APIs Externas Integradas
INMET_BASE_URL=https://apitempo.inmet.gov.br
BCB_BASE_URL=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata
CPTEC_BASE_URL=http://servicos.cptec.inpe.br/XML
BRAPI_BASE_URL=https://brapi.dev/api

# Ambiente & Observabilidade
ENVIRONMENT=production
LOG_LEVEL=INFO
SEED_DATABASE=false
